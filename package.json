{
  "name": "spacefast-frames",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:frames && bun run build:wordpress",
    "build:frames": "bun --filter @spacefast/frames build",
    "build:wordpress": "bun --filter @spacefast/wordpress-plugin build",
    "test": "bun --filter @spacefast/frames test && bun --filter @spacefast/wordpress-plugin test",
    "typecheck": "bun --filter @spacefast/frames typecheck && bun --filter @spacefast/wordpress-plugin typecheck",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "typescript": "^6.0.3"
  }
}
